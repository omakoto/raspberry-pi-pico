CONFIG_IDF_TARGET="esp32s3"

# Flash size (ESP32-S3-DevKitC-1 and Seeed Studio XIAO ESP32-S3 both have 8MB)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# PSRAM: 8 MB octal on the XIAO ESP32-S3 and the DevKitC-1-N8R8. With Wi-Fi and Bluetooth running, the internal
# RAM leaves a dispatcher about 60 KB of heap, which HTTPS requests with large answers (the SwitchBot device
# list) nearly use up. malloc() puts allocations above 4 KB in PSRAM, which keeps the internal RAM for the
# drivers (32 KB of it stays reserved for DMA and internal-only uses). A board without PSRAM (a DevKitC-1-N8)
# still boots, and then runs on the internal RAM alone.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Custom partition table: app, `storage` (config drive shown over USB), `state` (private settings)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# FreeRTOS 1kHz tick rate
CONFIG_FREERTOS_HZ=1000

# TinyUSB composite device (CDC ACM serial + MSC drive for config.toml)
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=4096

# FATFS and wear levelling
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_SECTOR_512=y
CONFIG_WL_SECTOR_SIZE_512=y

# Console output: default UART (UART0)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# Bluetooth: NimBLE as a scanner only (no connections, advertising or GATT), to save RAM
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=n

# HTTPS client: verify servers against the bundled root certificates
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
# TLS buffers sized to the data in flight, and the configuration and CA certificates freed after the
# handshake: with Wi-Fi and Bluetooth running, a dispatcher has under 60 KB of heap, and fixed 16 KB + 4 KB
# buffers next to a large response body (the SwitchBot device list) run it out.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
# TLS allocates with malloc(), so its large buffers go to PSRAM when there is some, and to the internal RAM
# on a board without it ("external only" would break TLS there).
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y

# HTTP server: room for the API's routes, long request lines and the asynchronous request helpers
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_WS_SUPPORT=n

# Networking and stack sizing
CONFIG_LWIP_SNTP_MAX_SERVERS=2
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
