CONFIG_IDF_TARGET="esp32s3"

# 4 MB is the smallest common flash size; the firmware also runs on 8 MB (XIAO) and 16 MB modules.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Full CPU speed: input latency matters more than power use.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 1 kHz tick: BTstack timers and task delays get 1 ms resolution.
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Bluetooth: ESP-IDF provides only the controller; BTstack is the host (components/btstack).
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
# Connections, scanning and advertising each take one activity: 8 connections + scan + 1 spare.
CONFIG_BT_CTRL_BLE_MAX_ACT=10
CONFIG_BT_CTRL_PINNED_TO_CORE_0=y
# Low input latency matters more than power use.
CONFIG_BT_CTRL_MODEM_SLEEP=n
CONFIG_PM_ENABLE=n

# TinyUSB (esp_tinyusb): keyboard/mouse HID + VIAL raw HID, plus a CDC serial port that is only part
# of the USB device when enabled at boot (PIN_USB_SERIAL_ENABLE).
CONFIG_TINYUSB_HID_COUNT=2
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_MSC_ENABLED=n

# Console on UART0 (GPIO43/44: the DevKitC's USB-UART bridge, or an adapter on the XIAO's D6/D7).
# Boot and panic messages always go there. The native USB port belongs to TinyUSB, so there is no
# USB-Serial-JTAG console.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Reboot when a watched task (the BTstack task and its run loop) makes no progress for 5 s.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_PANIC=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
