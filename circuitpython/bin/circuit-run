#!/bin/bash
# Shebang executor for CircuitPython scripts. Copies the script to the CircuitPython mount directory as code.py.
#
# To run the test:
#   src/pico/circuitpython/bin/circuit-run_test.bash
#
# Simple script, no help needed.

set -e

# Resolve the directory where this script and find-circut-dir reside
DIR="$(dirname "${BASH_SOURCE[0]}")"

if [[ -z "$1" ]]; then
  echo "Usage: $0 <script_to_copy>" >&2
  exit 1
fi

src_file="$1"
if [[ ! -f "$src_file" ]]; then
  echo "Error: File '$src_file' not found." >&2
  exit 1
fi

# Find the CircuitPython mount directory
if ! circuit_dir=$("$DIR/find-circut-dir" 2>/dev/null); then
  echo "Error: CircuitPython mount directory not found." >&2
  exit 1
fi

if [[ ! -d "$circuit_dir" ]]; then
  echo "Error: CircuitPython mount directory '$circuit_dir' does not exist or is not a directory." >&2
  exit 1
fi

dest_file="$circuit_dir/code.py"
echo "Copying '$src_file' to '$dest_file'..."

ee() {
  echo "Running: $*"
  "$@"
}

ee rm -f "$circuit_dir/boot.py"

# Prepend supervisor.runtime.autoreload = False to prevent unintended soft reboots
# caused by host OS desktop daemons and background USB filesystem access.
{
  echo -n "import supervisor; supervisor.runtime.autoreload = False;"
  cat "$src_file"
} > "$dest_file"

# Extract and copy files tagged with "#file:"
src_dir="$(dirname "$src_file")"
while IFS= read -r line; do
  if [[ "$line" =~ \#file:[[:space:]]*([^[:space:]]+) ]]; then
    tagged_file="${BASH_REMATCH[1]}"
    tagged_src_path="$src_dir/$tagged_file"
    tagged_dest_path="$circuit_dir/$(basename "$tagged_file")"
    
    if [[ -f "$tagged_src_path" ]]; then
      echo "Copying tagged file '$tagged_file' to '$tagged_dest_path'..."
      ee cp "$tagged_src_path" "$tagged_dest_path"
    else
      echo "Warning: Tagged file '$tagged_src_path' not found. Skipping." >&2
    fi
  fi
done < "$src_file"

if [[ -z "$MOCK_CIRCUIT_DIR" && -c /dev/ttyACM0 ]]; then
  # Send soft reboot sequence (Ctrl-C then Ctrl-D) to trigger immediate execution of new code.py
  python3 -c "import os; fd=os.open('/dev/ttyACM0', os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK); os.write(fd, b'\x03\x04'); os.close(fd)" 2>/dev/null || true
  echo 'Press ctrl-a ctrl-q to quit.'
  ee picocom -q -b 115200 /dev/ttyACM0
fi

